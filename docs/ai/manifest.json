{
  "schema_version": 1,
  "package": "arrowlane",
  "package_version": "0.4.0",
  "source": "arrowlane",
  "python_requires": ">=3.14",
  "install": {
    "pip": "pip install arrowlane",
    "extras": [
      "server",
      "pandas",
      "polars",
      "duckdb",
      "bench",
      "dev"
    ]
  },
  "entrypoints": {
    "transit": "arrowlane.transit",
    "chunks": "arrowlane.chunks",
    "describe": "arrowlane describe",
    "cli": "arrowlane.cli:main"
  },
  "lanes": [
    {
      "name": "json",
      "id": 1,
      "requires": "any",
      "media_type": "application/x-ndjson"
    },
    {
      "name": "ipc",
      "id": 2,
      "requires": "any",
      "media_type": "application/vnd.apache.arrow.stream"
    },
    {
      "name": "ipc-zstd",
      "id": 3,
      "requires": "any",
      "media_type": "application/vnd.apache.arrow.stream"
    },
    {
      "name": "shm",
      "id": 4,
      "requires": "posix",
      "media_type": "application/vnd.arrowlane.shm"
    }
  ],
  "limits": {
    "max_header_bytes": 65535,
    "max_payload_bytes": 536870912,
    "max_uncompressed_bytes": 1073741824,
    "max_segment_bytes": 536870912
  },
  "streaming": {
    "chunked": true,
    "default_chunk_rows": 50000,
    "max_chunk_rows": 10000000,
    "max_chunks": 1000000,
    "backpressure": "lazy iterator, one chunk in flight"
  },
  "docs": {
    "agents": "docs/ai/operating-guide.md",
    "llms": "llms.txt",
    "quickstart": "docs/ai/quickstart.md",
    "api": "docs/ai/api.md",
    "recipes": "docs/ai/recipes.md",
    "platforms": "docs/platforms.md",
    "decisions": "docs/ADR"
  },
  "checks": {
    "gate": "bash scripts/gate.sh",
    "tests": "python -m pytest -q",
    "bench": "python bench/verify.py",
    "memory": "python bench/memory_probe.py",
    "demo": "bash demo/verify.sh"
  }
}
